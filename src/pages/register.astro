---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Registro | Maaya Xíinbal">
  <main
    class="min-h-screen bg-maya-negro/10 flex items-center justify-center p-4"
  >
    <div
      class="bg-maya-blanco rounded-3xl shadow-2xl w-full max-w-4xl flex flex-col md:flex-row-reverse relative overflow-hidden"
    >
      <!-- Botón Cerrar (X) -->
      <a
        href="/"
        class="absolute top-6 right-6 md:left-6 md:right-auto text-maya-azul hover:text-maya-rojo transition-colors z-10"
        aria-label="Cerrar"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-8 w-8"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </a>

      <!-- Columna Derecha (en registro): Imagen -->
      <div class="md:w-1/2 p-6 md:p-8">
        <div
          class="w-full h-full border border-maya-negro/10 rounded-2xl overflow-hidden bg-maya-blanco aspect-square flex items-center justify-center p-2"
        >
          <!-- Puedes usar la misma imagen u otra para el registro -->
          <img
            src="/logo.png"
            alt="Ilustración Cultura Maya"
            class="w-full h-full object-contain rounded-xl"
          />
        </div>
      </div>

      <!-- Columna Izquierda: Formulario de Registro -->
      <div class="md:w-1/2 p-8 md:p-12 flex flex-col justify-center">
        <h1 class="text-4xl font-extrabold text-maya-azul mb-2">Registro</h1>
        <p class="text-maya-negro/70 mb-8 text-lg">
          Únete para descubrir las joyas ocultas de la región.
        </p>

        <form class="space-y-5 grow flex flex-col justify-center">
          <div class="flex flex-col">
            <label for="new-username" class="text-maya-azul font-semibold mb-1"
              >Nombre de Usuario</label
            >
            <input
              type="text"
              id="new-username"
              class="w-full border-b border-maya-negro/30 bg-transparent focus:outline-none focus:border-maya-azul py-1.5 transition-colors text-maya-negro"
            />
          </div>

          <div class="flex flex-col">
            <label for="new-email" class="text-maya-azul font-semibold mb-1"
              >Correo Electrónico</label
            >
            <input
              type="email"
              id="new-email"
              class="w-full border-b border-maya-negro/30 bg-transparent focus:outline-none focus:border-maya-azul py-1.5 transition-colors text-maya-negro"
            />
          </div>

          <div class="flex flex-col">
            <label for="new-password" class="text-maya-azul font-semibold mb-1"
              >Contraseña</label
            >
            <input
              type="password"
              id="new-password"
              class="w-full border-b border-maya-negro/30 bg-transparent focus:outline-none focus:border-maya-azul py-1.5 transition-colors text-maya-negro"
            />
          </div>

          <!-- Botón Registrarse -->
          <div class="pt-6">
            <button
              type="submit"
              class="w-full bg-maya-azul text-white font-bold py-3.5 rounded-xl hover:opacity-90 transition-opacity shadow-md"
            >
              Crear Cuenta
            </button>
          </div>
        </form>

        <p class="text-center mt-6 text-sm text-maya-negro/60">
          ¿Ya tienes cuenta? <a
            href="/login"
            class="text-maya-azul font-bold hover:underline">Inicia sesión</a
          >
        </p>
      </div>
    </div>
  </main>
</Layout>
