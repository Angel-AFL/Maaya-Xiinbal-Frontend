---
// Header personalizado para Maaya Xíinbal con traducción por Cookies
---

<header
  class="bg-maya-verde text-white md:h-20 flex flex-col md:flex-row items-center justify-between px-4 sm:px-6 lg:px-8 py-3 md:py-0 shadow-md relative z-50"
>
  <div class="flex justify-between items-center w-full md:w-auto">
    <a href="/" class="flex items-center gap-3 hover:opacity-90 transition-opacity">
      <img src="/logo.png" alt="Logo Maaya Xíinbal" class="h-16 w-16 drop-shadow-sm" />
      <h2 class="text-xl font-bold tracking-wide">Maaya Xíinbal</h2>
    </a>
    <button
      id="mobile-menu-btn"
      class="md:hidden p-2 text-white hover:text-maya-amarillo transition-colors focus:outline-none"
      aria-label="Abrir menú"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 32 32">
        <path d="M0 0h32v32H0z" fill="none"></path>
        <path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 8h22M5 16h22M5 24h22"></path>
      </svg>
    </button>
  </div>

  <nav
    id="nav-menu"
    class="hidden md:flex flex-col md:flex-row w-full md:w-auto items-center gap-6 mt-4 md:mt-0 pb-4 md:pb-0 transition-all duration-300"
  >
    <ul class="flex flex-col md:flex-row items-center gap-6 font-medium text-sm w-full md:w-auto">
      <li><a href="/" class="hover:text-maya-amarillo transition-colors block py-2 md:py-0">Inicio</a></li>
      <li><a href="#about" class="hover:text-maya-amarillo transition-colors block py-2 md:py-0">Acerca de</a></li>
      <li><a href="#experiences" class="hover:text-maya-amarillo transition-colors block py-2 md:py-0">Experiencias</a></li>
      <li><a href="/map" class="hover:text-maya-amarillo transition-colors block py-2 md:py-0">Mapa</a></li>
    </ul>

    <div class="hidden md:block w-px h-6 bg-maya-blanco/30"></div>
    <div class="md:hidden w-full h-px bg-maya-blanco/20 my-2"></div>

    <div class="flex flex-col md:flex-row items-center gap-4 w-full md:w-auto">
      <!-- TU BOTÓN REAL DE LA IMAGEN image_6aef63.png -->
      <button
        id="btn-cambiar-idioma"
        class="flex items-center gap-1.5 text-sm hover:text-maya-amarillo transition-colors font-semibold group"
        aria-label="Cambiar idioma"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 group-hover:animate-spin-slow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="2" y1="12" x2="22" y2="12"></line>
          <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
        </svg>
        <span id="texto-idioma">ES / MAY</span>
      </button>

      <!-- Div oculto obligatorio para que cargue la API de Google -->
      <div id="google_translate_element" class="hidden"></div>

      <div id="auth-actions" class="flex flex-col md:flex-row items-center gap-3 w-full md:w-auto">
        <a
          id="auth-link"
          href="/login"
          class="bg-maya-amarillo text-maya-negro px-5 py-2 rounded-lg font-bold text-sm hover:bg-maya-rojo hover:text-white transition-all duration-300 shadow-md w-full md:w-auto text-center mt-2 md:mt-0"
        >
          Iniciar sesión
        </a>
      </div>
    </div>
  </nav>
</header>

<!-- CSS GLOBAL: Oculta por completo la barra superior gris y los popups feos de Google -->
<style is:global>
  .goog-te-banner-frame, 
  .skiptranslate, 
  iframe.goog-te-banner-frame,
  .goog-te-balloon-frame {
    display: none !important;
    visibility: hidden !important;
  }
  body {
    top: 0 !important;
    position: static !important;
  }
  .goog-text-highlight {
    background-color: transparent !important;
    box-shadow: none !important;
  }
  #goog-gt-tt, .goog-te-balloon-frame, #goog-gt-tt * {
    display: none !important;
    visibility: hidden !important;
    opacity: 0 !important;
  }
</style>

<script>
  const setupMobileMenu = () => {
    const btn = document.getElementById("mobile-menu-btn");
    const menu = document.getElementById("nav-menu");
    if (btn && menu) {
      const newBtn = btn.cloneNode(true);
      btn.parentNode?.replaceChild(newBtn, btn);
      newBtn.addEventListener("click", () => {
        menu.classList.toggle("hidden");
        menu.classList.toggle("flex");
      });
    }
  };

  const setupAuthActions = () => {
    const container = document.getElementById("auth-actions");
    if (!container) return;

    const token = localStorage.getItem("auth_token");

    if (token) {
      container.innerHTML = `
        <a href="/profile" class="text-white/80 hover:text-maya-amarillo text-sm font-semibold transition-colors w-full md:w-auto text-center">
          Mi Perfil
        </a>
        <a href="#" id="logout-link" class="bg-maya-amarillo text-maya-negro px-5 py-2 rounded-lg font-bold text-sm hover:bg-maya-rojo hover:text-white transition-all duration-300 shadow-md w-full md:w-auto text-center">
          Cerrar sesión
        </a>
      `;
      document.getElementById("logout-link")?.addEventListener("click", (e) => {
        e.preventDefault();
        localStorage.removeItem("auth_token");
        window.location.href = "/";
      });
    } else {
      container.innerHTML = `
        <a href="/login" class="bg-maya-amarillo text-maya-negro px-5 py-2 rounded-lg font-bold text-sm hover:bg-maya-rojo hover:text-white transition-all duration-300 shadow-md w-full md:w-auto text-center mt-2 md:mt-0">
          Iniciar sesión
        </a>
      `;
    }
  };

  const setupTraductor = () => {
    const botonIdioma = document.getElementById("btn-cambiar-idioma");
    const textoBoton = document.getElementById("texto-idioma");

    // Función auxiliar para leer cookies
    const getCookie = (name: string) => {
      const value = `; ${document.cookie}`;
      const parts = value.split(`; ${name}=`);
      if (parts.length === 2) return parts.pop()?.split(';').shift();
      return null;
    };

    // Al cargar la página, revisamos la cookie para ajustar el texto del botón (ES / MAY)
    const currentTrans = getCookie('googtrans');
    if (currentTrans && currentTrans.includes('yua')) {
      if (textoBoton) textoBoton.innerText = "MAYA / ESP";
    }

    if (botonIdioma) {
      const nuevoBoton = botonIdioma.cloneNode(true);
      botonIdioma.parentNode?.replaceChild(nuevoBoton, botonIdioma);

      nuevoBoton.addEventListener("click", () => {
        const currentCookie = getCookie('googtrans');

        if (currentCookie && currentCookie.includes('yua')) {
          // Si ya está en maya, borramos las cookies de Google para volver a Español
          document.cookie = "googtrans=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/;";
          document.cookie = "googtrans=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/; domain=" + window.location.hostname;
          document.cookie = "googtrans=/es/es; path=/;"; // Forzar español
        } else {
          // Si está en español, escribimos la cookie oficial para traducir a Maya (/es/yua)
          document.cookie = "googtrans=/es/yua; path=/;";
          document.cookie = "googtrans=/es/yua; path=/; domain=" + window.location.hostname;
        }

        // Recargamos la página al instante para que Google aplique el idioma de la cookie de golpe
        window.location.reload();
      });
    }
  };

  // Inicializar
  setupMobileMenu();
  setupAuthActions();
  setupTraductor();

  document.addEventListener("astro:after-swap", () => {
    setupMobileMenu();
    setupAuthActions();
    setupTraductor();
  });
</script>