---
interface Props {
  title?: string;
  subtitle?: string;
}

const { title, subtitle } = Astro.props;
---

<section
  id="experiences"
  class="w-full max-w-7xl mx-auto py-10 px-4 sm:px-6 lg:px-8"
>
  {
    (title || subtitle) && (
      <div class="text-center mb-8 border-b border-maya-negro/10 pb-4">
        {title && <h2 class="text-3xl font-bold text-maya-negro">{title}</h2>}
        {subtitle && <p class="text-maya-negro/70 mt-2 text-lg">{subtitle}</p>}
      </div>
    )
  }

  <div
    class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6 md:gap-8"
  >
    <slot />
  </div>
</section>
