---
const currentYear = new Date().getFullYear();
---

<footer
  class="bg-maya-negro text-gray-200 pt-16 pb-8 border-t-4 border-maya-amarillo mt-20"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 mb-12">
      <div class="lg:col-span-1">
        <h3 class="text-2xl font-bold text-maya-amarillo mb-4">
          Maaya Xíinbal
        </h3>
        <p class="text-gray-400 text-sm leading-relaxed mb-6">
          Descubriendo el corazón de la península. Tu guía interactiva para
          explorar las maravillas naturales, la cultura viva y el legado
          histórico de nuestra región.
        </p>
        <div class="flex space-x-4">
          <a
            href="#"
            class="text-gray-400 hover:text-maya-amarillo transition-colors"
            aria-label="Facebook"
          >
            <svg
              class="w-6 h-6"
              fill="currentColor"
              viewBox="0 0 24 24"
              aria-hidden="true"
              ><path
                fill-rule="evenodd"
                d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z"
                clip-rule="evenodd"></path></svg
            >
          </a>
          <a
            href="#"
            class="text-gray-400 hover:text-maya-amarillo transition-colors"
            aria-label="Instagram"
          >
            <svg
              class="w-6 h-6"
              fill="currentColor"
              viewBox="0 0 24 24"
              aria-hidden="true"
              ><path
                fill-rule="evenodd"
                d="M12.315 2c2.43 0 2.784.013 3.808.06 1.064.049 1.791.218 2.427.465a4.902 4.902 0 011.772 1.153 4.902 4.902 0 011.153 1.772c.247.636.416 1.363.465 2.427.048 1.067.06 1.407.06 4.123v.08c0 2.643-.012 2.987-.06 4.043-.049 1.064-.218 1.791-.465 2.427a4.902 4.902 0 01-1.153 1.772 4.902 4.902 0 01-1.772 1.153c-.636.247-1.363.416-2.427.465-1.067.048-1.407.06-4.123.06h-.08c-2.643 0-2.987-.012-4.043-.06-1.064-.049-1.791-.218-2.427-.465a4.902 4.902 0 01-1.772-1.153 4.902 4.902 0 01-1.153-1.772c-.247-.636-.416-1.363-.465-2.427-.047-1.024-.06-1.379-.06-3.808v-.63c0-2.43.013-2.784.06-3.808.049-1.064.218-1.791.465-2.427a4.902 4.902 0 011.153-1.772A4.902 4.902 0 015.45 2.525c.636-.247 1.363-.416 2.427-.465C8.901 2.013 9.256 2 11.685 2h.63zm-.081 1.802h-.468c-2.456 0-2.784.011-3.807.058-.975.045-1.504.207-1.857.344-.467.182-.8.398-1.15.748-.35.35-.566.683-.748 1.15-.137.353-.3.882-.344 1.857-.047 1.023-.058 1.351-.058 3.807v.468c0 2.456.011 2.784.058 3.807.045.975.207 1.504.344 1.857.182.466.399.8.748 1.15.35.35.683.566 1.15.748.353.137.882.3 1.857.344 1.054.048 1.37.058 4.041.058h.08c2.597 0 2.917-.01 3.96-.058.976-.045 1.505-.207 1.858-.344.466-.182.8-.398 1.15-.748.35-.35.566-.683.748-1.15.137-.353.3-.882.344-1.857.048-1.055.058-1.37.058-4.041v-.08c0-2.597-.01-2.917-.058-3.96-.045-.976-.207-1.505-.344-1.858a3.097 3.097 0 00-.748-1.15 3.098 3.098 0 00-1.15-.748c-.353-.137-.882-.3-1.857-.344-1.023-.047-1.351-.058-3.807-.058zM12 6.865a5.135 5.135 0 110 10.27 5.135 5.135 0 010-10.27zm0 1.802a3.333 3.333 0 100 6.666 3.333 3.333 0 000-6.666zm5.338-3.205a1.2 1.2 0 110 2.4 1.2 1.2 0 010-2.4z"
                clip-rule="evenodd"></path></svg
            >
          </a>
        </div>
      </div>

      <div>
        <h4 class="text-lg font-semibold text-gray-100 mb-4">Destinos</h4>
        <ul class="space-y-2">
          <li>
            <a
              href="#cenotes"
              class="text-gray-400 hover:text-maya-amarillo transition-colors text-sm"
              >Cenotes Sagrados</a
            >
          </li>
          <li>
            <a
              href="#haciendas"
              class="text-gray-400 hover:text-maya-amarillo transition-colors text-sm"
              >Haciendas Henequeneras</a
            >
          </li>
          <li>
            <a
              href="#zonas-arqueologicas"
              class="text-gray-400 hover:text-maya-amarillo transition-colors text-sm"
              >Zonas Arqueológicas</a
            >
          </li>
          <li>
            <a
              href="#pueblos-magicos"
              class="text-gray-400 hover:text-maya-amarillo transition-colors text-sm"
              >Pueblos Mágicos</a
            >
          </li>
        </ul>
      </div>

      <div>
        <h4 class="text-lg font-semibold text-gray-100 mb-4">
          Para el Viajero
        </h4>
        <ul class="space-y-2">
          <li>
            <a
              href="#mapa"
              class="text-gray-400 hover:text-maya-amarillo transition-colors text-sm"
              >Mapa Interactivo</a
            >
          </li>
          <li>
            <a
              href="#clima"
              class="text-gray-400 hover:text-maya-amarillo transition-colors text-sm"
              >Clima y Temporadas</a
            >
          </li>
          <li>
            <a
              href="#transporte"
              class="text-gray-400 hover:text-maya-amarillo transition-colors text-sm"
              >Opciones de Transporte</a
            >
          </li>
          <li>
            <a
              href="#blog"
              class="text-gray-400 hover:text-maya-amarillo transition-colors text-sm"
              >Blog de Experiencias</a
            >
          </li>
        </ul>
      </div>

      <div>
        <h4 class="text-lg font-semibold text-gray-100 mb-4">Contacto</h4>
        <ul class="space-y-4 text-sm text-gray-400">
          <li class="flex items-start">
            <svg
              class="w-5 h-5 mr-3 text-maya-rojo shrink-0 mt-0.5"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
              ></path><path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg
            >
            <span>Maxcanú, Yucatán, México</span>
          </li>
          <li class="flex items-center">
            <svg
              class="w-5 h-5 mr-3 text-maya-rojo shrink-0"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
              ></path></svg
            >
            <a
              href="mailto:hola@maayaxiinbal.com"
              class="hover:text-maya-amarillo transition-colors"
              >hola@maayaxiinbal.com</a
            >
          </li>
        </ul>

        <div class="mt-6">
          <label for="newsletter" class="block text-sm text-gray-100 mb-2"
            >Suscríbete al boletín</label
          >
          <div class="flex">
            <input
              type="email"
              id="newsletter"
              placeholder="Tu correo"
              class="bg-gray-800 text-gray-200 text-sm rounded-l-md px-3 py-2 w-full focus:outline-none focus:ring-1 focus:ring-maya-amarillo border border-gray-700 placeholder-gray-500"
            />
            <button
              class="bg-maya-rojo hover:bg-maya-amarillo text-white hover:text-maya-negro px-4 py-2 rounded-r-md transition-colors font-medium text-sm"
            >
              Enviar
            </button>
          </div>
        </div>
      </div>
    </div>

    <div
      class="border-t border-gray-700 pt-8 flex flex-col md:flex-row justify-between items-center text-sm text-gray-500"
    >
      <p>&copy; {currentYear} Maaya Xíinbal. Todos los derechos reservados.</p>
      <div class="flex space-x-6 mt-4 md:mt-0">
        <a href="/privacidad" class="hover:text-maya-amarillo transition-colors"
          >Aviso de Privacidad</a
        >
        <a href="/terminos" class="hover:text-maya-amarillo transition-colors"
          >Términos de Uso</a
        >
      </div>
    </div>
  </div>
</footer>
